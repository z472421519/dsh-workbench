{
  "name": "dsh-agent-board",
  "version": "0.1.0",
  "description": "A live Session board in the left sidebar: needs-you / running / recent, one row per Session",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "sidebar",
    "agentbar"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/z472421519/dsh-workbench.git",
    "directory": "dsh-agent-board"
  },
  "author": {
    "name": "z472421519",
    "email": "z472421519@163.com"
  }
}
